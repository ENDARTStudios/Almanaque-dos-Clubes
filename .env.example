# Almanaque dos Clubes — variáveis de ambiente
# Copie este arquivo para .env e ajuste conforme o ambiente.

# =============================================================================
# BANCO DE DADOS
# =============================================================================
# SANDBOX (SQLite — para validação rápida sem Docker):
DATABASE_URL="file:./dev.db"

# PRODUÇÃO / LOCAL COM DOCKER (PostgreSQL):
# Descomente a linha abaixo e comente a do SQLite quando for usar Docker.
# DATABASE_URL="postgresql://almanaque:almanaque_dev_2025@localhost:5432/almanaque?schema=public"

# Qual schema o Prisma deve usar (arquivo .prisma):
# - "postgres"  → prisma/schema.prisma        (produção / Docker)
# - "sqlite"    → prisma/schema.sqlite.prisma  (sandbox)
PRISMA_SCHEMA_PROVIDER="sqlite"

# =============================================================================
# SERVIDOR
# =============================================================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# =============================================================================
# LOG
# =============================================================================
LOG_LEVEL=info

# =============================================================================
# AUTH (JWT)
# =============================================================================
# ATENÇÃO: em PRODUÇÃO, JWT_SECRET e JWT_REFRESH_SECRET são OBRIGATÓRIOS e devem
# ser strings aleatórias de no mínimo 32 caracteres. Em desenvolvimento, se não
# definidos, o sistema gera defaults efêmeros (que mudam a cada restart).
#
# Gerar segredos:
#   openssl rand -base64 48
#
# Em produção, JWT_SECRET e JWT_REFRESH_SECRET NÃO podem ser iguais.
JWT_SECRET="SUA_CHAVE_JWT_AQUI"
JWT_REFRESH_SECRET="SUA_CHAVE_REFRESH_AQUI"

# Duração dos tokens (formato: <número><unidade> onde unidade ∈ {ms,s,m,h,d,w,y})
# Access token: 15 minutos (curto para limitar dano se vazado)
# Refresh token: 7 dias (alinhado com REFRESH_TOKEN_EXPIRES_MS em session.service.ts)
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# =============================================================================
# UPLOAD — S3-compatível (MinIO em dev, Cloudflare R2 em prod)
# =============================================================================
# Endpoint do S3 (MinIO local ou R2/Backblaze em prod):
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="almanaque"
S3_SECRET_ACCESS_KEY="almanaque_dev_2025"
S3_BUCKET="almanaque-uploads"
# Tamanho máximo de upload em bytes (padrão: 50 MiB)
UPLOAD_MAX_BYTES=52428800
# Tipos MIME permitidos (separados por vírgula)
UPLOAD_ALLOWED_MIMES="image/jpeg,image/png,image/webp,application/pdf,text/csv"

# =============================================================================
# REDIS — Fila assíncrona e cache
# =============================================================================
REDIS_HOST="localhost"
REDIS_PORT=6379
