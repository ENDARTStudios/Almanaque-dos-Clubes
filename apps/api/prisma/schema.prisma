// =============================================================================
// Almanaque dos Clubes — Prisma Schema (POSTGRESQL — CANÔNICO)
// =============================================================================
// Este é o schema canônico. Use este arquivo no ambiente Windows com Docker.
//
// Para rodar migrations localmente:
//   pnpm --filter @almanaque/api exec prisma migrate dev \
//     --schema=prisma/schema.prisma --name init
//
// DATABASE_URL esperada:
//   postgresql://almanaque:almanaque_dev_2025@localhost:5432/almanaque?schema=public
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// EXTENSÕES POSTGRESQL — declaradas aqui apenas como documentação.
// A criação efetiva acontece em `prisma/extensions.sql` aplicado via migrate.ps1
// (Prisma não suporta CREATE EXTENSION declarativamente).
// Extensões: uuid-ossp (UUID v4), pgcrypto (hash), pg_trgm (similaridade textual).
// -----------------------------------------------------------------------------

// -----------------------------------------------------------------------------
// CLUBES
// -----------------------------------------------------------------------------

model Club {
  favorites Favorite[]
  id           String     @id @default(uuid())
  name         String
  fullName     String?
  shortName    String?
  city         String?
  state        String?
  country      String?    @db.VarChar(2) // ISO 3166-1 alpha-2
  foundedYear  Int?
  status       ClubStatus @default(ACTIVE)
  primaryColor String?    @db.Char(7) // #RRGGBB
  website      String?
  qid          String?    @unique // Wikidata Q-identifier (ex: Q12345)
  latitude     Float?     // Coordenada (P625) de localização do clube (mapa-múndi)
  longitude    Float?     // Coordenada (P625) de localização do clube (mapa-múndi)
  importedFrom String?    // "wikidata", "rsssf", "fbref", "football-data", "thesportsdb", "manual"
  importedAt   DateTime?
  sourceUrl    String?    // URL pública de origem (auditabilidade; ex.: https://www.wikidata.org/wiki/Q12345)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Coluna tsvector Unsupported para busca full-text (definida via SQL raw).
  // Ver `prisma/fulltext-indexes.sql` e evidência 2.11.
  search_vector Unsupported("tsvector")?

  // Relações
  players       Player[]
  rankings      RankingEntry[]
  homeMatches   Match[]    @relation("homeMatches")
  awayMatches   Match[]    @relation("awayMatches")
  stadiums      Stadium[]  // Um clube pode ter vários estádios ao longo da história
  // `creator` opcional: quem cadastrou (admin). Null se importado por ETL.
  // (AuditLog é polimórfico via entityType+entityId — sem FK explícita para Club.)
  createdBy     String?
  createdByUser User?      @relation("ClubCreatedByUser", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([name, country])
  @@index([country])
  @@index([city])
  @@index([status])
  @@index([qid])
  // Índices compostos para buscas filtradas frequentes (Tarefa 2.4)
  @@index([country, status])
  @@index([city, state])
  @@map("clubs")
}

enum ClubStatus {
  ACTIVE
  INACTIVE
  DISSOLVED
}

// -----------------------------------------------------------------------------
// JOGADORES
// -----------------------------------------------------------------------------

model Player {
  id           String    @id @default(uuid())
  fullName     String
  shortName    String?
  birthDate    DateTime?
  country      String?   @db.VarChar(2)
  position     String?
  clubId       String?
  club         Club?     @relation(fields: [clubId], references: [id], onDelete: SetNull)
  qid          String?   @unique // Wikidata Q-identifier
  importedFrom String?   // "wikidata", "rsssf", "fbref", "football-data", "thesportsdb", "manual"
  importedAt   DateTime?
  sourceUrl    String?   // URL pública de origem (auditabilidade; ex.: https://www.wikidata.org/wiki/Q12345)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  search_vector Unsupported("tsvector")?

  @@index([country])
  @@index([birthDate])
  @@index([clubId])
  @@index([fullName])
  @@index([qid])
  @@map("players")
}

// -----------------------------------------------------------------------------
// COMPETIÇÕES
// -----------------------------------------------------------------------------

model Competition {
  id           String   @id @default(uuid())
  name         String
  country      String?  @db.VarChar(2)
  type         CompetitionType?
  qid          String?  @unique // Wikidata Q-identifier
  importedFrom String?  // "wikidata", "rsssf", "fbref", "football-data", "thesportsdb", "manual"
  importedAt   DateTime?
  sourceUrl    String?  // URL pública de origem (auditabilidade; ex.: https://www.wikidata.org/wiki/Q12345)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  search_vector Unsupported("tsvector")?

  // Relações
  rankings Ranking[]
  matches  Match[]

  @@index([country])
  @@index([type])
  @@index([qid])
  @@map("competitions")
}

enum CompetitionType {
  LEAGUE
  CUP
  TOURNAMENT
  SUPER_CUP
}

// -----------------------------------------------------------------------------
// RANKINGS — cabeçalho de um ranking (ex.: "Ranking CBF 2023")
// -----------------------------------------------------------------------------

model Ranking {
  id             String   @id @default(uuid())
  name           String
  competitionId  String?
  competition    Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  season         String?  // ex.: "2023"
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entries RankingEntry[]

  @@index([competitionId])
  @@index([season])
  @@map("rankings")
}

// -----------------------------------------------------------------------------
// RANKING ENTRY — uma posição específica em um ranking
// -----------------------------------------------------------------------------

model RankingEntry {
  id            String   @id @default(uuid())
  rankingId     String
  ranking       Ranking  @relation(fields: [rankingId], references: [id], onDelete: Cascade)
  clubId        String
  club          Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  // position NULL = registro sem posição publicada (dados insuficientes) — T425
  position      Int?     // 1 = primeiro, 2 = segundo, etc.; NULL = não ranqueado
  points        Int?     // 0-100 normalizado por gênero; NULL se dados insuficientes
  // Base auditável do ranking (T425) — a UI exibe "com base em N partidas / T títulos".
  baseMatches   Int?     // nº de partidas que compõem a base do clube-ano
  baseTitles    Int?     // nº de títulos auditáveis que compõem a base
  dataSourceIds Json?    // proveniência (ex.: ["rsssf","wikidata"]) — JSONB
  reason        String?  // NULL ou motivo de não-publicação (ex.: "dados insuficientes")
  gender        String?  // "men" | "women" — isolamento por gênero (T425)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([rankingId, clubId])
  @@unique([rankingId, position])
  @@index([rankingId])
  @@index([clubId])
  @@index([position])
  @@index([gender])
  @@map("ranking_entries")
}

// -----------------------------------------------------------------------------
// USUÁRIOS
// -----------------------------------------------------------------------------

model User {
  favorites Favorite[]
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  passwordHash  String   // argon2id (ver apps/api/src/config/crypto.ts)
  status        UserStatus @default(ACTIVE)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relações
  sessions      Session[]
  auditLogs     AuditLog[]
  subscriptions Subscription[]
  billings      Billing[]
  userRoles     UserRole[]
  clubsCreated  Club[]   @relation("ClubCreatedByUser")

  @@index([status])
  @@index([createdAt])
  // Índice composto: validação de login (email + status) — útil para "encontrar
  // usuários ativos por email" sem table scan
  @@index([email, status])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

// -----------------------------------------------------------------------------
// SESSIONS — autenticação stateless via refresh token
// -----------------------------------------------------------------------------

model Session {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique // SHA-256 do refresh token (ver crypto.ts)
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime? // null = ativa; não-null = revogada
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  // Índice composto: busca de sessão ativa por usuário (tokens não revogados)
  @@index([userId, revokedAt])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// RBAC — Role-Based Access Control
// -----------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // admin, pro, free
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique // ex.: "clubs:read", "clubs:write", "users:manage"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// -----------------------------------------------------------------------------
// SUBSCRIPTIONS / BILLING (SaaS)
// -----------------------------------------------------------------------------

model Subscription {
  id          String             @id @default(uuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan   @default(FREE)
  status      SubscriptionStatus @default(PENDING)
  startedAt   DateTime           @default(now())
  cancelledAt DateTime?
  currentPeriodEnd DateTime?
  trial_used_at DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  billings Billing[]

  @@index([plan])
  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionPlan {
  FREE
  PRO
  ELITE
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  PENDING
}

model Billing {
  id             String             @id @default(uuid())
  subscriptionId String
  subscription   Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents    Int
  currency       String             @default("BRL") @db.VarChar(3)
  status         BillingStatus      @default(PENDING)
  paidAt         DateTime?
  externalId     String? // ID no provedor de pagamento
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([subscriptionId])
  @@index([userId])
  @@index([status])
  // Índice composto: histórico de cobranças pagas por usuário (relatório financeiro)
  @@index([userId, status, paidAt])
  @@map("billings")
}

// -----------------------------------------------------------------------------
// COMPETIÇÕES — Season (temporada/edição de competição)
// -----------------------------------------------------------------------------

enum SeasonStatus {
  PLANNED
  ONGOING
  FINISHED
}

model Season {
  id        String       @id @default(uuid())
  name      String       // "2024", "2024-2025", etc.
  startDate DateTime?
  endDate   DateTime?
  status    SeasonStatus @default(PLANNED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  matches Match[]

  @@index([status])
  @@index([startDate])
  @@map("seasons")
}

// -----------------------------------------------------------------------------
// ESTÁDIOS — Stadium (dados do OpenStreetMap + Wikidata)
// -----------------------------------------------------------------------------

model Stadium {
  id           String   @id @default(uuid())
  name         String
  city         String?
  state        String?
  country      String?  @db.VarChar(2)
  latitude     Float?
  longitude    Float?
  capacity     Int?
  surface      String?  // grass, artificial, hybrid
  // Coordenada PostGIS (EWKT: SRID=4326) — coluna geometry(Point,4326). Ver migration
  // 20260905_stadiums_postgis e docs/DATA-INGESTION.md §13.
  location     Unsupported("geometry(Point,4326)")?
  qid          String?  @unique // Wikidata Q-identifier
  clubId       String?  // clube mandante principal
  club         Club?    @relation(fields: [clubId], references: [id], onDelete: SetNull)
  importedFrom String?  // "wikidata", "openstreetmap", "manual"
  importedAt   DateTime?
  sourceUrl    String?  // URL pública de origem (auditabilidade; ex.: https://www.wikidata.org/wiki/Q12345)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  matches Match[]

  @@index([clubId])
  @@index([country])
  @@index([qid])
  @@map("stadiums")
}

// -----------------------------------------------------------------------------
// PARTIDAS — Match
// -----------------------------------------------------------------------------

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
  POSTPONED
}

model Match {
  id            String      @id @default(uuid())
  homeClubId    String
  homeClub      Club        @relation("homeMatches", fields: [homeClubId], references: [id], onDelete: Cascade)
  awayClubId    String
  awayClub      Club        @relation("awayMatches", fields: [awayClubId], references: [id], onDelete: Cascade)
  date          DateTime
  competitionId String?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  seasonId      String?
  season        Season?     @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  homeScore     Int?
  awayScore     Int?
  round         String?     // "1", "2", "final", "semifinal", etc.
  venue         String?     // nome do estádio (texto livre)
  stadiumId     String?
  stadium       Stadium?    @relation(fields: [stadiumId], references: [id], onDelete: SetNull)
  status        MatchStatus @default(SCHEDULED)
  qid           String?     @unique  // Wikidata match QID (raro; quando houver item de partida)
  importedFrom  String?     // "wikidata", "rsssf", "fbref", "football-data", "thesportsdb", "manual"
  importedAt    DateTime?
  sourceUrl     String?     // URL pública de origem da partida
  license       String?     // licença/uso da fonte (ex.: "CC0", "RSSSF") — proveniência
  dedupKey      String?     @unique  // chave estável: competicao|temporada|dataISO|homeClubId|awayClubId
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([homeClubId])
  @@index([awayClubId])
  @@index([date])
  @@index([competitionId])
  @@index([seasonId])
  @@index([status])
  @@index([stadiumId])
  @@index([homeClubId, awayClubId, date])
  // T430 — declarados porque as migrations os criam de verdade
  // (20260905_deep_data_match_provenance); sem isso o drift check
  // os reportaria como DROP. dedupKey já é @unique (índice próprio);
  // este @@index espelha o índice nominal criado pela migration.
  @@index([importedFrom])
  @@index([dedupKey])
  @@map("matches")
}

// -----------------------------------------------------------------------------
// KNOWLEDGE GRAPH — relações entre entidades (jogador→clube→competição→título)
// -----------------------------------------------------------------------------

model KnowledgeGraph {
  id         String   @id @default(uuid())
  sourceId   String
  sourceType String   // "Club", "Player", "Competition"
  targetId   String
  targetType String   // "Club", "Player", "Competition"
  relation   String   // "PLAYED_FOR", "MANAGED_BY", "PART_OF", "WON", "RIVAL"
  metadata   Json?    // {season, year, ...}
  createdAt  DateTime @default(now())

  @@index([sourceId, sourceType])
  @@index([targetId, targetType])
  @@index([relation])
  @@index([sourceType, relation])
  @@map("knowledge_graph")
}

enum BillingStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
  CANCELLED
}

// -----------------------------------------------------------------------------
// WS-L 1ª CAMADA — Consentimento de cookies (LGPD) — T436
// Prova auditável de consentimento por visitante; versionado para
// rastrear mudanças na política de cookies.
// -----------------------------------------------------------------------------

model CookieConsent {
  id         String   @id @default(uuid())
  visitorId  String   // hash anônimo do visitante (cookie httpOnly + localStorage)
  version    String   // versão da política vigente no momento do consentimento
  categories Json     // { necessary: true, preferences: boolean, analytics: boolean, personalization: boolean, marketing: boolean }
  consentedAt DateTime @default(now())
  userAgent  String?
  ipHash     String?  // hash SHA-256 do IP (não armazena IP em claro)
  revokedAt  DateTime?
  metadata   Json?    // { source: "banner" | "preferences" | "api", ... }

  @@index([visitorId])
  @@index([version])
  @@index([consentedAt])
  @@map("cookie_consents")
}

model CookiePolicyVersion {
  id          String   @id @default(uuid())
  version     String   @unique // "1.0", "1.1", etc.
  effectiveAt DateTime @default(now())
  checksum    String?  // SHA-256 do conteúdo da política no momento
  createdAt   DateTime @default(now())

  @@map("cookie_policy_versions")
}

// -----------------------------------------------------------------------------
// WS-C 2ª CAMADA — Favoritos do usuário (T439)
// Soft-delete (deletedAt) — princípio 1.1: sem hard-delete de dado de usuário.
// Índice parcial único (userId, clubId) WHERE deletedAt IS NULL vive na
// migration (Prisma não expressa índice parcial).
// RLS owner-only: policies em scripts/sql/rls_favorites_setup.sql (fora de
// migrations, mesmo padrão de sessions) + acesso via withRlsContext.
// -----------------------------------------------------------------------------

model Favorite {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId              String
  club                Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  notificationsActive Boolean  @default(true)
  createdAt           DateTime @default(now())
  deletedAt           DateTime?

  @@index([userId])
  @@index([clubId])
  @@index([userId, deletedAt])
  @@map("favorites")
}


// -----------------------------------------------------------------------------
// WS-P — Log de eventos de pagamento (T444). Idempotência de webhook por
// `providerEventId` UNIQUE: o mesmo evento processado 2× gera 1 efeito.
// -----------------------------------------------------------------------------

model PaymentEvent {
  id              String   @id @default(uuid())
  provider        String // "stripe" | "mock"
  providerEventId String   @unique
  type            String
  payload         Json?
  processedAt     DateTime @default(now())

  @@map("payment_events")
}


// -----------------------------------------------------------------------------
// AUDIT LOG — append-only (somente insert). NUNCA update/delete via Prisma.
// Rastreia mudanças em entidades críticas para conformidade e segurança.
// -----------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   // "User", "Club", "Subscription", "Session", etc.
  entityId   String   // ID da entidade afetada
  action     String   // "create", "update", "delete", "login", "logout", "deny", etc.
  userId     String?  // quem executou (null se sistema)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  changes    Json?   // {field: {old, new}, ...} — JSONB no PostgreSQL
  metadata   Json?    // {ip, userAgent, ...} — JSONB
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
