// =============================================================================
// Almanaque dos Clubes — Prisma Schema (SQLITE — SANDBOX)
// =============================================================================
// Esta versão é usada APENAS para validar a API no sandbox Linux onde não há
// Docker/PostgreSQL disponível. A lógica de domínio é IDÊNTICA à versão
// PostgreSQL; apenas o provider e os tipos específicos de coluna mudam.
//
// Para rodar migrations:
//   pnpm --filter @almanaque/api exec prisma migrate dev \
//     --schema=prisma/schema.sqlite.prisma --name init
//
// DATABASE_URL esperada:
//   file:./dev.db
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// CLUBES
// -----------------------------------------------------------------------------
// SQLite não suporta enums nativos — usamos String + validação no domínio.

model Club {
  id           String   @id @default(uuid())
  name         String
  fullName     String?
  shortName    String?
  city         String?
  state        String?
  country      String?  // ISO 3166-1 alpha-2
  foundedYear  Int?
  status       String   @default("ACTIVE") // ACTIVE | INACTIVE | DISSOLVED
  primaryColor String?  // #RRGGBB
  website      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([name, country])
  @@index([country])
  @@index([city])
  @@index([status])
  @@map("clubs")
}

// -----------------------------------------------------------------------------
// JOGADORES (esqueleto)
// -----------------------------------------------------------------------------

model Player {
  id          String   @id @default(uuid())
  fullName    String
  shortName   String?
  birthDate   DateTime?
  country     String?
  position    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([country])
  @@index([birthDate])
  @@map("players")
}

// -----------------------------------------------------------------------------
// COMPETIÇÕES (esqueleto)
// -----------------------------------------------------------------------------

model Competition {
  id        String   @id @default(uuid())
  name      String
  country   String?
  type      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("competitions")
}
