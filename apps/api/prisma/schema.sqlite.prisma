// =============================================================================
// Almanaque dos Clubes — Prisma Schema (SQLITE — SANDBOX)
// =============================================================================
// Esta versão é usada APENAS para validar a API no sandbox Linux onde não há
// Docker/PostgreSQL disponível. A lógica de domínio é IDÊNTICA à versão
// PostgreSQL; apenas o provider e os tipos específicos de coluna mudam.
//
// Para rodar migrations:
//   pnpm --filter @almanaque/api exec prisma migrate dev \
//     --schema=prisma/schema.sqlite.prisma --name init
//
// DATABASE_URL esperada:
//   file:./dev.db
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite não suporta enums nativos nem Unsupported("tsvector").
// Usamos String + validação no domínio.

// -----------------------------------------------------------------------------
// CLUBES
// -----------------------------------------------------------------------------

model Club {
  favorites Favorite[]
  id           String   @id @default(uuid())
  name         String
  fullName     String?
  shortName    String?
  city         String?
  state        String?
  country      String? // ISO 3166-1 alpha-2
  foundedYear  Int?
  status       String   @default("ACTIVE") // ACTIVE | INACTIVE | DISSOLVED
  primaryColor String? // #RRGGBB
  website      String?
  qid          String?  @unique // Wikidata Q-identifier
  latitude     Float?   // Coordenada (P625) — paridade com schema.prisma (T426)
  longitude    Float?   // Coordenada (P625) — paridade com schema.prisma (T426)
  importedFrom String?  // "wikidata", "rsssf", "fbref", "football-data", "thesportsdb", "manual"
  importedAt   DateTime?
  sourceUrl    String?  // URL pública de origem (auditabilidade; ex.: https://www.wikidata.org/wiki/Q12345)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime? // T449EN — soft-delete (ruído); exclui das views por padrão

  // Relações
  players       Player[]
  rankings      RankingEntry[]
  homeMatches   Match[]    @relation("homeMatches")
  awayMatches   Match[]    @relation("awayMatches")
  stadiums      Stadium[]  // Um clube pode ter vários estádios ao longo da história
  // `creator` opcional: quem cadastrou (admin). Null se importado por ETL.
  // (AuditLog é polimórfico via entityType+entityId — sem FK explícita para Club.)
  createdBy     String?
  createdByUser User?    @relation("ClubCreatedByUser", fields: [createdBy], references: [id], onDelete: SetNull)

  // T466 — geografia normalizada (FKs nullable; campos texto legados preservados)
  countryId String?
  countryRef Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  stateId   String?
  stateRef   State?   @relation(fields: [stateId], references: [id], onDelete: SetNull)
  cityId    String?
  cityRef    City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@unique([name, country])
  @@index([country])
  @@index([city])
  @@index([status])
  @@index([qid])
  @@index([country, status])
  @@index([city, state])
  @@index([countryId])
  @@index([stateId])
  @@index([cityId])
  @@map("clubs")
}

model Player {
  id           String   @id @default(uuid())
  fullName     String
  shortName    String?
  birthDate    DateTime?
  country      String?
  position     String?
  clubId       String?
  club         Club?    @relation(fields: [clubId], references: [id], onDelete: SetNull)
  qid          String?  @unique // Wikidata Q-identifier
  importedFrom String?  // "wikidata", "rsssf", "fbref", "football-data", "thesportsdb", "manual"
  importedAt   DateTime?
  sourceUrl    String?  // URL pública de origem (auditabilidade; ex.: https://www.wikidata.org/wiki/Q12345)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([country])
  @@index([birthDate])
  @@index([clubId])
  @@index([fullName])
  @@index([qid])
  @@map("players")
}

model Competition {
  id           String   @id @default(uuid())
  name         String
  country      String?
  type         String? // LEAGUE | CUP | TOURNAMENT | SUPER_CUP
  qid          String?  @unique // Wikidata Q-identifier
  importedFrom String?  // "wikidata", "rsssf", "fbref", "football-data", "thesportsdb", "manual"
  importedAt   DateTime?
  sourceUrl    String?  // URL pública de origem (auditabilidade; ex.: https://www.wikidata.org/wiki/Q12345)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rankings Ranking[]

  @@index([country])
  @@index([type])
  @@index([qid])
  @@map("competitions")
}

// (Player, Competition definidos acima no bloco Club)

// -----------------------------------------------------------------------------
// RANKINGS — cabeçalho de um ranking (ex.: "Ranking CBF 2023")
// -----------------------------------------------------------------------------

model Ranking {
  id             String   @id @default(uuid())
  name           String
  competitionId  String?
  competition    Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  season         String?
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entries RankingEntry[]

  @@index([competitionId])
  @@index([season])
  @@map("rankings")
}

// -----------------------------------------------------------------------------
// RANKING ENTRY — uma posição específica em um ranking
// -----------------------------------------------------------------------------

model RankingEntry {
  id          String   @id @default(uuid())
  rankingId   String
  ranking     Ranking  @relation(fields: [rankingId], references: [id], onDelete: Cascade)
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  // position NULL = registro sem posição publicada (dados insuficientes) — T425
  position    Int?
  points      Int?     // 0-100 normalizado por gênero; NULL se dados insuficientes
  baseMatches Int?     // nº de partidas que compõem a base do clube-ano (T425)
  baseTitles  Int?     // nº de títulos auditáveis que compõem a base
  dataSourceIds String? // JSON.stringify(proveniência) — espelho sqlite de Json (T425)
  reason      String?  // NULL ou motivo de não-publicação (ex.: "dados insuficientes")
  gender      String?  // "men" | "women" — isolamento por gênero (T425)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([rankingId, clubId])
  @@unique([rankingId, position])
  @@index([rankingId])
  @@index([clubId])
  @@index([position])
  @@map("ranking_entries")
}

// -----------------------------------------------------------------------------
// USUÁRIOS
// -----------------------------------------------------------------------------

model User {
  favorites Favorite[]
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  passwordHash  String
  status        String   @default("ACTIVE") // ACTIVE | INACTIVE | SUSPENDED | PENDING
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime? // T470 — soft-delete (titular); e-mail anonimizado

  sessions      Session[]
  auditLogs     AuditLog[]
  subscriptions Subscription[]
  billings      Billing[]
  userRoles     UserRole[]
  clubsCreated  Club[]   @relation("ClubCreatedByUser")
  dataSubjectRequests DataSubjectRequest[]
  copyrightNotices    CopyrightNotice[]

  @@index([status])
  @@index([createdAt])
  @@index([email, status])
  @@map("users")
}

// -----------------------------------------------------------------------------
// SESSIONS — autenticação stateless via refresh token
// -----------------------------------------------------------------------------

model Session {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([userId, revokedAt])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// RBAC — Role-Based Access Control
// -----------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// -----------------------------------------------------------------------------
// SUBSCRIPTIONS / BILLING (SaaS)
// -----------------------------------------------------------------------------

model Subscription {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        String    @default("FREE") // FREE | PRO | ELITE
  status      String    @default("PENDING") // ACTIVE | INACTIVE | CANCELLED | EXPIRED | PENDING
  startedAt   DateTime  @default(now())
  cancelledAt DateTime?
  currentPeriodEnd DateTime?
  trial_used_at DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  billings Billing[]

  @@index([plan])
  @@index([status])
  @@map("subscriptions")
}

model Billing {
  id             String   @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents    Int
  currency       String   @default("BRL")
  status         String   @default("PENDING") // PENDING | PAID | REFUNDED | FAILED | CANCELLED
  paidAt         DateTime?
  externalId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([subscriptionId])
  @@index([userId])
  @@index([status])
  @@index([userId, status, paidAt])
  @@map("billings")
}

// WS-C 2ª CAMADA — Favoritos (T439). Espelho sqlite: sem índice parcial
// (sqlite/Prisma não suportam) — idempotência garantida no service; RLS é
// exclusiva de Postgres (scripts/sql/rls_favorites_setup.sql).
model Favorite {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId              String
  club                Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  notificationsActive Boolean  @default(true)
  createdAt           DateTime @default(now())
  deletedAt           DateTime?

  @@index([userId])
  @@index([clubId])
  @@index([userId, deletedAt])
  @@map("favorites")
}

// -----------------------------------------------------------------------------
// AUDIT LOG — append-only
// -----------------------------------------------------------------------------

model Season {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime?
  endDate   DateTime?
  status    String   @default("PLANNED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches Match[]

  @@index([status])
  @@index([startDate])
  @@map("seasons")
}

model Stadium {
  id           String   @id @default(uuid())
  name         String
  city         String?
  state        String?
  country      String?
  latitude     Float?
  longitude    Float?
  capacity     Int?
  surface      String?
  qid          String?  @unique // Wikidata Q-identifier
  clubId       String?
  club         Club?    @relation(fields: [clubId], references: [id], onDelete: SetNull)

  // T466 — geografia normalizada (FKs nullable)
  countryId String?
  countryRef Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  stateId   String?
  stateRef   State?   @relation(fields: [stateId], references: [id], onDelete: SetNull)
  cityId    String?
  cityRef    City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)

  importedFrom String?
  importedAt   DateTime?
  sourceUrl    String?  // URL pública de origem (auditabilidade; ex.: https://www.wikidata.org/wiki/Q12345)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  matches Match[]

  @@index([clubId])
  @@index([country])
  @@index([qid])
  @@index([countryId])
  @@index([stateId])
  @@index([cityId])
  @@map("stadiums")
}

// -----------------------------------------------------------------------------
// GEOGRAFIA (T466) — paridade com schema.prisma (SQLite: String em vez de enum/@db.*)
// -----------------------------------------------------------------------------

model Country {
  id           String   @id @default(uuid())
  iso2         String   @unique
  iso3         String?
  name         String
  continent    String?
  latitude     Float?
  longitude    Float?
  qid          String?  @unique
  importedFrom String?
  importedAt   DateTime?
  sourceUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  states   State[]
  cities   City[]
  clubs    Club[]
  stadiums Stadium[]

  @@index([continent])
  @@map("countries")
}

model State {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  countryId    String
  country      Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  latitude     Float?
  longitude    Float?
  qid          String?  @unique
  importedFrom String?
  importedAt   DateTime?
  sourceUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cities   City[]
  clubs    Club[]
  stadiums Stadium[]

  @@index([countryId])
  @@map("states")
}

model City {
  id           String   @id @default(uuid())
  qid          String?  @unique
  name         String
  countryId    String
  country      Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  stateId      String?
  state        State?   @relation(fields: [stateId], references: [id], onDelete: SetNull)
  latitude     Float?
  longitude    Float?
  importedFrom String?
  importedAt   DateTime?
  sourceUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clubs    Club[]
  stadiums Stadium[]

  @@index([countryId])
  @@index([stateId])
  @@map("cities")
}

model Match {
  id            String   @id @default(uuid())
  homeClubId    String
  homeClub      Club     @relation("homeMatches", fields: [homeClubId], references: [id], onDelete: Cascade)
  awayClubId    String
  awayClub      Club     @relation("awayMatches", fields: [awayClubId], references: [id], onDelete: Cascade)
  date          DateTime
  competitionId String?
  seasonId      String?
  season        Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  homeScore     Int?
  awayScore     Int?
  round         String?
  venue         String?
  stadiumId     String?
  stadium       Stadium? @relation(fields: [stadiumId], references: [id], onDelete: SetNull)
  status        String   @default("SCHEDULED")
  qid           String?  @unique
  importedFrom  String?
  importedAt    DateTime?
  sourceUrl     String?
  license       String?
  dedupKey      String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([homeClubId])
  @@index([awayClubId])
  @@index([date])
  @@index([competitionId])
  @@index([seasonId])
  @@index([status])
  @@index([stadiumId])
  @@index([homeClubId, awayClubId, date])
  @@map("matches")
}

model KnowledgeGraph {
  id         String   @id @default(uuid())
  sourceId   String
  sourceType String
  targetId   String
  targetType String
  relation   String
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([sourceId, sourceType])
  @@index([targetId, targetType])
  @@index([relation])
  @@index([sourceType, relation])
  @@map("knowledge_graph")
}

// WS-L 1ª CAMADA — Consentimento de cookies (LGPD) — T436
// Espelho SQLite do modelo em schema.prisma (Json → String serializado).
model CookieConsent {
  id          String   @id @default(uuid())
  visitorId   String
  version     String
  categories  String // JSON.stringify({ necessary, preferences, analytics, personalization, marketing })
  consentedAt DateTime @default(now())
  userAgent   String?
  ipHash      String?
  revokedAt   DateTime?
  metadata    String? // JSON.stringify({ source, ... })

  @@index([visitorId])
  @@index([version])
  @@index([consentedAt])
  @@map("cookie_consents")
}

model CookiePolicyVersion {
  id          String   @id @default(uuid())
  version     String   @unique
  effectiveAt DateTime @default(now())
  checksum    String?
  createdAt   DateTime @default(now())

  @@map("cookie_policy_versions")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // SQLite não suporta Json? nativamente — usamos String com serialização JSON
  changes    String?  // JSON.stringify(changes) — lido via JSON.parse na aplicação
  metadata   String?  // JSON.stringify(metadata) — lido via JSON.parse na aplicação
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// T445 — Direitos do titular (LGPD art. 18) e DMCA (espelho sqlite)
// -----------------------------------------------------------------------------

model PrivacyRequest {
  id            String    @id @default(uuid())
  requesterId   String?
  email         String
  rightType     String
  status        String    @default("recebido")
  token         String?   @unique
  slaDueAt      DateTime
  fulfilledAt   DateTime?
  deferredUntil DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([status, slaDueAt])
  @@map("privacy_requests")
}

model CopyrightClaim {
  id           String    @id @default(uuid())
  material     String
  location     String
  fundament    String
  contactEmail String
  status       String    @default("recebida")
  resolution   String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@map("copyright_claims")
}

// -----------------------------------------------------------------------------
// T470 — Direitos do titular + notificação autoral (espelho sqlite; enums = String,
// Json = String serializado — mesma convenção do AuditLog acima).
// -----------------------------------------------------------------------------

model DataSubjectRequest {
  id              String    @id @default(uuid())
  protocol        String    @unique
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String // DsrType
  jurisdiction    String    @default("BR")
  status          String    @default("received")
  description     String?
  requestedFields String? // JSON.stringify(…) — lido via JSON.parse
  deadlineAt      DateTime?
  completedAt     DateTime?
  responseSummary String?
  internalNote    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([deadlineAt])
  @@index([protocol])
  @@map("data_subject_requests")
}

model CopyrightNotice {
  id                   String    @id @default(uuid())
  protocol             String    @unique
  type                 String // CopyrightNoticeType
  status               String    @default("received")
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalNoticeId     String?
  originalNotice       CopyrightNotice? @relation("NoticeCounter", fields: [originalNoticeId], references: [id], onDelete: SetNull)
  counterNotices       CopyrightNotice[] @relation("NoticeCounter")
  workTitle            String
  workUrl              String?
  materialUrl          String
  description          String
  goodFaithDeclaration Boolean
  accuracyDeclaration  Boolean
  signatureText        String
  jurisdiction         String    @default("BR")
  responseSummary      String?
  internalNote         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([originalNoticeId])
  @@index([protocol])
  @@map("copyright_notices")
}
