// =============================================================================
// Almanaque dos Clubes — Prisma Schema (SQLITE — SANDBOX)
// =============================================================================
// Esta versão é usada APENAS para validar a API no sandbox Linux onde não há
// Docker/PostgreSQL disponível. A lógica de domínio é IDÊNTICA à versão
// PostgreSQL; apenas o provider e os tipos específicos de coluna mudam.
//
// Para rodar migrations:
//   pnpm --filter @almanaque/api exec prisma migrate dev \
//     --schema=prisma/schema.sqlite.prisma --name init
//
// DATABASE_URL esperada:
//   file:./dev.db
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite não suporta enums nativos nem Unsupported("tsvector").
// Usamos String + validação no domínio.

// -----------------------------------------------------------------------------
// CLUBES
// -----------------------------------------------------------------------------

model Club {
  id           String   @id @default(uuid())
  name         String
  fullName     String?
  shortName    String?
  city         String?
  state        String?
  country      String? // ISO 3166-1 alpha-2
  foundedYear  Int?
  status       String   @default("ACTIVE") // ACTIVE | INACTIVE | DISSOLVED
  primaryColor String? // #RRGGBB
  website      String?
  qid          String?  @unique // Wikidata Q-identifier
  importedFrom String?  // "wikidata", "rsssf", "fbref", "football-data", "thesportsdb", "manual"
  importedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relações
  players       Player[]
  rankings      RankingEntry[]
  homeMatches   Match[]    @relation("homeMatches")
  awayMatches   Match[]    @relation("awayMatches")
  stadiums      Stadium[]  // Um clube pode ter vários estádios ao longo da história
  // `creator` opcional: quem cadastrou (admin). Null se importado por ETL.
  // (AuditLog é polimórfico via entityType+entityId — sem FK explícita para Club.)
  createdBy     String?
  createdByUser User?    @relation("ClubCreatedByUser", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([name, country])
  @@index([country])
  @@index([city])
  @@index([status])
  @@index([qid])
  @@index([country, status])
  @@index([city, state])
  @@map("clubs")
}

model Player {
  id           String   @id @default(uuid())
  fullName     String
  shortName    String?
  birthDate    DateTime?
  country      String?
  position     String?
  clubId       String?
  club         Club?    @relation(fields: [clubId], references: [id], onDelete: SetNull)
  qid          String?  @unique // Wikidata Q-identifier
  importedFrom String?  // "wikidata", "rsssf", "fbref", "football-data", "thesportsdb", "manual"
  importedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([country])
  @@index([birthDate])
  @@index([clubId])
  @@index([fullName])
  @@index([qid])
  @@map("players")
}

model Competition {
  id           String   @id @default(uuid())
  name         String
  country      String?
  type         String? // LEAGUE | CUP | TOURNAMENT | SUPER_CUP
  qid          String?  @unique // Wikidata Q-identifier
  importedFrom String?  // "wikidata", "rsssf", "fbref", "football-data", "thesportsdb", "manual"
  importedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rankings Ranking[]

  @@index([country])
  @@index([type])
  @@index([qid])
  @@map("competitions")
}

// (Player, Competition definidos acima no bloco Club)

// -----------------------------------------------------------------------------
// RANKINGS — cabeçalho de um ranking (ex.: "Ranking CBF 2023")
// -----------------------------------------------------------------------------

model Ranking {
  id             String   @id @default(uuid())
  name           String
  competitionId  String?
  competition    Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  season         String?
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entries RankingEntry[]

  @@index([competitionId])
  @@index([season])
  @@map("rankings")
}

// -----------------------------------------------------------------------------
// RANKING ENTRY — uma posição específica em um ranking
// -----------------------------------------------------------------------------

model RankingEntry {
  id          String   @id @default(uuid())
  rankingId   String
  ranking     Ranking  @relation(fields: [rankingId], references: [id], onDelete: Cascade)
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  position    Int
  points      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([rankingId, clubId])
  @@unique([rankingId, position])
  @@index([rankingId])
  @@index([clubId])
  @@index([position])
  @@map("ranking_entries")
}

// -----------------------------------------------------------------------------
// USUÁRIOS
// -----------------------------------------------------------------------------

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  passwordHash  String
  status        String   @default("ACTIVE") // ACTIVE | INACTIVE | SUSPENDED | PENDING
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  auditLogs     AuditLog[]
  subscriptions Subscription[]
  billings      Billing[]
  userRoles     UserRole[]
  clubsCreated  Club[]   @relation("ClubCreatedByUser")

  @@index([status])
  @@index([createdAt])
  @@index([email, status])
  @@map("users")
}

// -----------------------------------------------------------------------------
// SESSIONS — autenticação stateless via refresh token
// -----------------------------------------------------------------------------

model Session {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([userId, revokedAt])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// RBAC — Role-Based Access Control
// -----------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// -----------------------------------------------------------------------------
// SUBSCRIPTIONS / BILLING (SaaS)
// -----------------------------------------------------------------------------

model Subscription {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        String    @default("FREE") // FREE | PRO | ELITE
  status      String    @default("PENDING") // ACTIVE | INACTIVE | CANCELLED | EXPIRED | PENDING
  startedAt   DateTime  @default(now())
  cancelledAt DateTime?
  currentPeriodEnd DateTime?
  trial_used_at DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  billings Billing[]

  @@index([plan])
  @@index([status])
  @@map("subscriptions")
}

model Billing {
  id             String   @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents    Int
  currency       String   @default("BRL")
  status         String   @default("PENDING") // PENDING | PAID | REFUNDED | FAILED | CANCELLED
  paidAt         DateTime?
  externalId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([subscriptionId])
  @@index([userId])
  @@index([status])
  @@index([userId, status, paidAt])
  @@map("billings")
}

// -----------------------------------------------------------------------------
// AUDIT LOG — append-only
// -----------------------------------------------------------------------------

model Season {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime?
  endDate   DateTime?
  status    String   @default("PLANNED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches Match[]

  @@index([status])
  @@index([startDate])
  @@map("seasons")
}

model Stadium {
  id           String   @id @default(uuid())
  name         String
  city         String?
  state        String?
  country      String?
  latitude     Float?
  longitude    Float?
  capacity     Int?
  surface      String?
  qid          String?  @unique // Wikidata Q-identifier
  clubId       String?
  club         Club?    @relation(fields: [clubId], references: [id], onDelete: SetNull)
  importedFrom String?
  importedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  matches Match[]

  @@index([clubId])
  @@index([country])
  @@index([qid])
  @@map("stadiums")
}

model Match {
  id            String   @id @default(uuid())
  homeClubId    String
  homeClub      Club     @relation("homeMatches", fields: [homeClubId], references: [id], onDelete: Cascade)
  awayClubId    String
  awayClub      Club     @relation("awayMatches", fields: [awayClubId], references: [id], onDelete: Cascade)
  date          DateTime
  competitionId String?
  seasonId      String?
  season        Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  homeScore     Int?
  awayScore     Int?
  round         String?
  venue         String?
  stadiumId     String?
  stadium       Stadium? @relation(fields: [stadiumId], references: [id], onDelete: SetNull)
  status        String   @default("SCHEDULED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([homeClubId])
  @@index([awayClubId])
  @@index([date])
  @@index([competitionId])
  @@index([seasonId])
  @@index([status])
  @@index([stadiumId])
  @@index([homeClubId, awayClubId, date])
  @@map("matches")
}

model KnowledgeGraph {
  id         String   @id @default(uuid())
  sourceId   String
  sourceType String
  targetId   String
  targetType String
  relation   String
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([sourceId, sourceType])
  @@index([targetId, targetType])
  @@index([relation])
  @@index([sourceType, relation])
  @@map("knowledge_graph")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // SQLite não suporta Json? nativamente — usamos String com serialização JSON
  changes    String?  // JSON.stringify(changes) — lido via JSON.parse na aplicação
  metadata   String?  // JSON.stringify(metadata) — lido via JSON.parse na aplicação
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
