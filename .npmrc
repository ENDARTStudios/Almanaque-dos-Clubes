# Allow Prisma and esbuild to run their postinstall scripts (engine download)
# Required for prisma generate / migrate to work.

# Vercel CI sets CI=true, which makes pnpm default to --frozen-lockfile.
# Desabilitamos porque o lockfile pode estar ligeiramente dessincronizado
# entre pnpm@10 (Vercel builder) e pnpm@11 (local).
frozen-lockfile=false
