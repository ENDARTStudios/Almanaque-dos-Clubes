version: "3.9"

services:
  postgres:
    image: postgres:16-alpine
    container_name: almanaque-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: almanaque
      POSTGRES_PASSWORD: almanaque_dev_2025
      POSTGRES_DB: almanaque
    ports:
      - "5432:5432"
    volumes:
      - almanaque_pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U almanaque -d almanaque"]
      interval: 5s
      timeout: 5s
      retries: 10

volumes:
  almanaque_pgdata:
    name: almanaque_pgdata
